# Template only - the real, filled-in grudge.env is sent separately and never
# committed. On the server it lives at /etc/grudge.env, readable by root only
# (root:root, chmod 600): systemd reads it on the services' behalf, so the
# app's own `grudge` user - which sandboxed player code also runs as - never
# needs to. See ../README.md, Transfer step 5. Field names match
# backend/src/grudge_backend/config.py's Settings exactly (no GRUDGE_ prefix) -
# see that file for what each one does.

# --- Database ---
# Real prod Postgres creds - NOT the dev grudge/grudge_dev_password pair.
DATABASE_URL=postgresql+asyncpg://grudge:CHANGEME@localhost:5432/grudge

# --- Secrets - generate fresh values, don't reuse the dev placeholders ---
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
OAUTH_STATE_SECRET=
INTERNAL_SHARED_SECRET=

# --- Google OAuth ---
# The same client as dev - one OAuth client can hold multiple authorized
# redirect URIs, so production doesn't need a new Google Cloud project. The
# production redirect URI is added in Google Cloud Console separately, not
# as part of server setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URLs ---
# The two public subdomains: https://grudge.<domain> and
# https://api.grudge.<domain> (see ../README.md, Transfer step 10).
# BACKEND_BASE_URL is what browsers and Google see - the sign-in redirect
# address is built from it.
FRONTEND_BASE_URL=https://CHANGEME
BACKEND_BASE_URL=https://CHANGEME

# Where the worker/watchdog reach the backend on this same machine. The
# default already matches grudge-backend.service - only set this if the
# backend moves to a different port, and never to the public address above.
# INTERNAL_BASE_URL=http://127.0.0.1:8000

# --- Cookies ---
# Must be true wherever the app is served over https (i.e. always in
# production) - see config.py's cookie_secure.
COOKIE_SECURE=true

# --- Sandbox ---
# MUST be nsjail before any real user code reaches the worker - defaults to
# the insecure "dev" backend otherwise. This is the single most important
# line in this file.
SANDBOX_BACKEND=nsjail

# --- Alerting ---
# Confirmed: reusing the same webhook as dev is fine for this project's
# size - a separate one would avoid mixing real stall alerts with dev/test
# noise in the same channel, but that's a minor risk here, not worth a
# second webhook. The real value lives in the real grudge.env, not
# this template.
DISCORD_WEBHOOK_URL=

# --- Do not set ---
# MATCHMAKING_ROOM_CAPACITY_OVERRIDE must stay unset here. It exists only so
# Playwright E2E tests can shrink the room-fill target below 4 - a live room
# capped below 4 in production would start ranked/unranked tournaments with
# the wrong number of players.
