# Copy to /etc/grudge-backup.env on the production server, readable by root
# only (root:root, chmod 600 - it holds a DB password; systemd reads it on the
# backup service's behalf) and fill in real values. See ../README.md, Transfer
# steps 5 and 11. Never commit the filled-in version.

PGHOST=localhost
PGPORT=5432
PGUSER=grudge_backup_ro
PGPASSWORD=changeme
PGDATABASE=grudge

# rclone remote:path to upload dumps to - see rclone.conf.example. The real
# rclone.conf (sent separately, see ../README.md Transfer step 11) names its
# remote "r2", so this stays r2:<bucket> unless that changes.
RCLONE_REMOTE=r2:grudge-backups

# Optional overrides - see backup_db.sh for defaults.
# BACKUP_DIR=/var/backups/grudge
# KEEP_DAILY=7
